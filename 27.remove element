class Solution(object):
    def removeElement(self, nums, val):
        i = 0
        n = len(nums)
        j = n-1
        # if nums[i] == val and len(nums) == 1:
           # return []
        while(i <= j):
            while(i <= j and nums[i] != val):
                 i += 1
            while(i<=j and nums[j] == val):
                j -= 1
            if(i<j):
                nums[i],nums[j] = nums[j],nums[i]
                i +=1
                j -=1
        return i      
