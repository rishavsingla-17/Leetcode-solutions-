class Solution(object):
    def search(self, nums, target):
        n = len(nums)
        low = 0
        high = n-1
        found = 0
        while(low<=high):
            mid = (low+high)//2
            if(nums[mid] == target):
                found += 1
                return mid
            elif(nums[mid] > target):
                high = mid-1
            else:
                low = mid+1
        if found == 0:
            return -1
        
